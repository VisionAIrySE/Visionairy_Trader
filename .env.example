# Values belong in local environment or Render secret settings, never Git.
TRADING_MODE=paper
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Supply server credentials through secure configuration when the adapter is ready.
SUPABASE_SECRET_KEY=
DATABASE_URL=
TRADIER_PRODUCTION_TOKEN=
# Data reads only; this does not enable trading. Select production or sandbox.
TRADIER_DATA_ENVIRONMENT=production
TRADIER_SANDBOX_TOKEN=
# Optional only when the authenticated profile contains multiple accounts.
TRADIER_ACCOUNT_ID=

